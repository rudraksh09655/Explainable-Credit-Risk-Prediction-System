# Copy this file to .env for local development and fill in your actual values.
# Never commit .env to GitHub.

SECRET_KEY=change_me_to_a_random_string

# Local MySQL example
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=loan_prediction

# Optional: path to the CA certificate for a managed MySQL service such as Aiven.
# Leave empty if your provider does not require/configure it this way.
DB_SSL_CA=

# Keep false for local HTTP. Render sets this to true through render.yaml.
COOKIE_SECURE=false
